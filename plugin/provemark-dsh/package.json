{
  "name": "provemark-dsh",
  "version": "0.7.1",
  "description": "DeepSeek Harness skill bundle for Provemark（源印）— local, zero-dependency originality & risk scanning: license combination conflicts, vulnerable dependencies, leaked credentials, PII, AI-code risks, supply chain and repo hygiene.",
  "license": "Apache-2.0",
  "author": "Provemark Contributors",
  "type": "module",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mw2wbyys6t-sudo/provemark-open.git",
    "directory": "plugin/provemark-dsh"
  },
  "homepage": "https://github.com/mw2wbyys6t-sudo/provemark-open/tree/main/plugin/provemark-dsh#readme",
  "bugs": {
    "url": "https://github.com/mw2wbyys6t-sudo/provemark-open/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "selftest": "node scripts/selftest.mjs",
    "sync": "node scripts/sync-vendor.mjs",
    "doctor": "node scripts/doctor.mjs",
    "stress": "node scripts/stress.mjs",
    "release": "node scripts/release.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "provemark-dsh": "./bin/provemark.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "skills",
    "python",
    "scripts",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "provemark",
    "security",
    "license-compliance",
    "sbom",
    "secrets",
    "pii",
    "supply-chain",
    "ai-code"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  }
}
